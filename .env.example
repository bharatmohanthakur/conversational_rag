# Azure OpenAI Credentials
AZURE_OPENAI_API_KEY="your-azure-openai-api-key-here"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2025-03-01-preview"
AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-large"

# SQL Server Database (optional, for database features)
DB_SERVER="your-server.database.windows.net,1433"
DB_NAME="your-database"
DB_USER="your-username"
DB_PASSWORD="your-password"

# ODBC Connection String (optional)
ODBC_CONN_STR="DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-server.database.windows.net,1433;DATABASE=your-database;UID=your-username;PWD=your-password;TrustServerCertificate=yes;"

# Output Configuration
OUTPUT_CSV_PATH="effective_dates_all_articles.csv"
LOG_LEVEL="INFO"

# Multimodal RAG specific variables
AOAI_VISION_DEPLOYMENT="gpt-4o"
AOAI_EMBED_DEPLOYMENT="text-embedding-3-large"
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://your-ocr-resource.cognitiveservices.azure.com/"
AZURE_DOCUMENT_INTELLIGENCE_KEY="your-document-intelligence-key-here"

# Graphiti/Neo4j settings (optional, for graph memory)
GRAPHITI_GROUP_ID="your-group-id"
GRAPHITI_ENABLED="false"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# Qdrant settings
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="docs_hybrid_azure"
